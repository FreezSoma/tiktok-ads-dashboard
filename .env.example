# ============================================================
#  TikTok Ads Dashboard - environment configuration (Vercel)
#  Copy to ".env" for LOCAL dev (`vercel dev`), or set these as
#  Environment Variables in the Vercel dashboard for production.
#  NEVER commit the real .env file.
# ============================================================

# --- TikTok Developer App credentials ---
# https://business-api.tiktok.com/portal -> your app
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=

# OAuth redirect URI registered in your TikTok app (used during authorization).
# In production, use your Vercel URL, e.g. https://your-app.vercel.app/api/auth/callback
TIKTOK_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Long-lived access token obtained after the OAuth flow (see README section 5).
TIKTOK_ACCESS_TOKEN=

# API base (do not change unless TikTok changes it).
TIKTOK_API_BASE=https://business-api.tiktok.com

# --- Persistent store (Upstash Redis) ---
# Required in production so automation state, locks, idempotency and logs
# survive across serverless invocations. Create a free DB at https://upstash.com
# (or use Vercel KV, which also exposes KV_REST_API_URL / KV_REST_API_TOKEN).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cron protection ---
# A random secret. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
# Generate one, e.g.: openssl rand -hex 32
CRON_SECRET=

# --- Misc ---
# Allowed CORS origins (comma-separated). Same-origin on Vercel, so "*" is fine
# unless you host the frontend on a different domain.
CORS_ORIGIN=*
TIMEZONE=Europe/Paris
CURRENCY=EUR
